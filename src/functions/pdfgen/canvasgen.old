import jsPDF from "jspdf";
import html2canvas from "html2canvas";

export default async function CanvasGen(element, savefilename) {
    const pdf = new jsPDF("p", "mm", "a4");

    const pageWidth = 210; // A4 width in mm
    const pageHeight = 297; // A4 height in mm

    const canvas = await html2canvas(element, {
        scale: 2, // Improves quality
    });

    const imgData = canvas.toDataURL("image/png");

    const imgWidth = pageWidth; // Image width matches A4 width
    const imgHeight = (canvas.height * imgWidth) / canvas.width; // Maintain aspect ratio

    let currentHeight = 0;

    while (currentHeight < canvas.height) {
        const sliceCanvas = document.createElement("canvas");
        const sliceContext = sliceCanvas.getContext("2d");

        sliceCanvas.width = canvas.width;
        sliceCanvas.height = Math.min(canvas.height - currentHeight, (pageHeight / imgWidth) * canvas.width);

        sliceContext.drawImage(
            canvas,
            0,
            currentHeight,
            canvas.width,
            sliceCanvas.height,
            0,
            0,
            canvas.width,
            sliceCanvas.height
        );

        const sliceImgData = sliceCanvas.toDataURL("image/png");

        if (currentHeight > 0) {
            pdf.addPage();
        }

        pdf.addImage(sliceImgData, "PNG", 0, 0, imgWidth, (sliceCanvas.height * imgWidth) / canvas.width);
        currentHeight += sliceCanvas.height;
    }

    pdf.save(`${savefilename}.pdf`);
}
