generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model employee {
  id           Int        @id @default(autoincrement())
  Surname      String     @db.VarChar(45)
  Firstname    String?    @db.VarChar(45)
  Initials     String     @db.VarChar(45)
  EmpNo        String     @unique(map: "EmpNo_UNIQUE") @db.VarChar(45)
  EpfNo        String     @unique(map: "EpfNo_UNIQUE") @db.VarChar(45)
  Nic_Passport String     @unique(map: "Nic_Passport_UNIQUE") @db.VarChar(45)
  pay_roll     pay_roll[]
}

model user {
  id           Int    @id @default(autoincrement())
  email        String @unique(map: "email_UNIQUE") @db.VarChar(100)
  account_type String @default("user") @db.VarChar(45)
  enabled      Int    @default(0)
  password     String @db.VarChar(450)
}

model pay_rates {
  id          Int    @id @default(autoincrement())
  description String @db.VarChar(100)
  pay_rate    Float  @default(0)
  pay_code    Int    @unique(map: "pay_code_UNIQUE")
}

model pay_roll {
  id                  Int       @id @default(autoincrement())
  work_days           Float     @default(0)
  per_day_salary      Float     @default(1500)
  bra_2005            Float     @default(0)
  bra_2016            Float     @default(0)
  sundays             Float     @default(0)
  sunday_rate         Float     @default(1.5)
  sunday_allowance    Float     @default(0)
  stat_days           Float     @default(0)
  stat_rate           Float?    @default(2)
  stat_allowance      Float     @default(0)
  poya_days           Float     @default(0)
  poya_rate           Float     @default(1.5)
  poya_allowance      Float     @default(0)
  night_shifts        Float     @default(0)
  night_shift_rate    Float     @default(2)
  normal_ot           Float     @default(0)
  normal_ot_rate      Float     @default(1.5)
  normal_ot_allowance Float     @default(0)
  double_ot           Float     @default(0)
  double_ot_rate      Float     @default(2)
  double_ot_allowance Float     @default(0)
  triple_ot           Float     @default(0)
  triple_ot_rate      Float     @default(3)
  triple_ot_allowance Float     @default(0)
  advance             Float     @default(0)
  festival_advance    Float     @default(0)
  loan_amount         Float     @default(0)
  payroll_date        DateTime? @db.Date
  emp_id              Int
  employee            employee  @relation(fields: [emp_id], references: [id], onUpdate: NoAction, map: "emp_key")

  @@index([emp_id], map: "FK")
}
